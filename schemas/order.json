{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "product",
    "quantity"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    }
  }
}
